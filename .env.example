# ── Required ──────────────────────────────────────────────────────────────────
# GitHub Personal Access Token (classic or fine-grained). Used by Scorecard,
# the GitHub SBOM/dependency API, and all GitHub metrics collection
# (contributors, commits, issues, merged PRs, stars, forks, license, language).
# Minimum scopes: public_repo (read), read:packages
GITHUB_AUTH_TOKEN=github_pat_YOUR_TOKEN_HERE

# ── Scorecard tuning ──────────────────────────────────────────────────────────
# Seconds to wait before timing out a single Scorecard invocation.
SCORECARD_TIMEOUT=120
# Number of additional retry attempts on transient failure.
SCORECARD_RETRY_COUNT=1

# ── Dependency analysis ───────────────────────────────────────────────────────
# Number of parallel workers for the SBOM + OSV dependency scan.
DEPENDENCY_MAX_WORKERS=4
# HTTP request timeout (seconds) per dependency API call.
DEPENDENCY_HTTP_TIMEOUT=30
# Number of additional retry attempts on transient HTTP failure.
DEPENDENCY_RETRY_COUNT=2
