# ── Required ──────────────────────────────────────────────────────────────────
# GitHub Personal Access Token (classic or fine-grained). Used by Scorecard,
# the GitHub SBOM/dependency API, and the GitHub REST fallback in the merger.
# Minimum scopes: public_repo (read), read:packages
GITHUB_AUTH_TOKEN=github_pat_YOUR_TOKEN_HERE

# ── Aveloxis (Augur) ──────────────────────────────────────────────────────────
# Only needed when using Docker / Aveloxis for commit/contributor metrics.
# Skip these (and pass --skip-augur) if you are not running the Aveloxis stack.
AUGUR_API_BASE=http://localhost:8383
AUGUR_API_KEY=                        # leave blank unless you configured one
AUGUR_REPO_GROUP=ag-oss-pipeline

# ── Scorecard tuning ──────────────────────────────────────────────────────────
# Seconds to wait before timing out a single Scorecard invocation.
SCORECARD_TIMEOUT=120
# Number of additional retry attempts on transient failure.
SCORECARD_RETRY_COUNT=1

# ── Aveloxis wait behaviour ───────────────────────────────────────────────────
# How long (seconds) to wait for the Aveloxis API to respond on startup.
AUGUR_TIMEOUT=30
# Collection wait mode: none | minimal | standard | full
#   none     – do not wait after registration; proceed immediately
#   minimal  – wait up to 5 min for partial data
#   standard – wait up to 30 min for most metrics
#   full     – wait up to AUGUR_WAIT_TIMEOUT seconds
AUGUR_WAIT_MODE=none
# Seconds between poll attempts when waiting for Aveloxis collection.
AUGUR_POLL_INTERVAL=30
# Maximum total seconds to wait for Aveloxis collection (used in full mode).
AUGUR_WAIT_TIMEOUT=600

# ── Dependency analysis ───────────────────────────────────────────────────────
# Number of parallel workers for the SBOM + OSV dependency scan.
DEPENDENCY_MAX_WORKERS=4
# HTTP request timeout (seconds) per dependency API call.
DEPENDENCY_HTTP_TIMEOUT=30
# Number of additional retry attempts on transient HTTP failure.
DEPENDENCY_RETRY_COUNT=2

# ── Docker / Aveloxis internals (usually no need to change) ──────────────────
# Name of the running Augur PostgreSQL container (match `docker ps` output).
AUGUR_DB_CONTAINER=augur-postgres-1
# PostgreSQL user inside the Aveloxis container.
AUGUR_DB_USER=aveloxis
# PostgreSQL database name inside the Aveloxis container.
AUGUR_DB_NAME=aveloxis
